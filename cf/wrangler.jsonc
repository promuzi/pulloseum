// 풀로세움 v2 Cloudflare 판 — 주소 = https://pulloseum.getchat.workers.dev (homocarbo · 메카와 같은 계정, workers.dev 하위 주소 'getchat'은 바꾸지 않음 — 갯챗이 깨짐)
//  올리기 = cf/배포.md · 정적 파일 모으기 = node cf/build.mjs(cf/public, 깃 밖)
{
  "name": "pulloseum",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  "observability": { "enabled": true },
  // 구글 로그인 웹 클라이언트 ID(공개값 — 화면에도 그대로 보임, 비밀값 아님) · 만드는 법 = cf/배포.md '구글 로그인 켜기'
  "vars": { "GOOGLE_CLIENT_ID": "19442831901-l49q0ut04btc9brrhig9oqb0jt4f3i98.apps.googleusercontent.com" }
}
